---
import { getEntry, render } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHead from '../components/PageHead.astro';
import now from '../data/now.json';

// Body text lives in src/content/pages/about.md and is edited from the admin panel.
const entry = await getEntry('pages', 'about');
const { Content } = entry ? await render(entry) : { Content: null };
const data = entry?.data ?? { title: 'about', eyebrow: '01 / who\'s typing', description: '' };
---
<BaseLayout title={data.title} description={data.description || 'Who Maya is, in slightly more than one paragraph.'}>
  <section class="page-shell shell-narrow">
    <PageHead eyebrow={data.eyebrow} title={data.title} description={data.description} />

    <div class="prose">
      {Content ? <Content /> : <p>this page is empty right now — add it back from the admin panel.</p>}
    </div>

    <div class="now" style="margin-top:46px">
      <div>
        <div class="now-label">RIGHT NOW</div>
        <div class="now-track">♫ <span>{now.track}</span> — {now.artist}</div>
      </div>
      <p class="quote" style="cursor:default">{now.note}{now.mood ? ` · ${now.mood}` : ''}</p>
    </div>
  </section>
</BaseLayout>
