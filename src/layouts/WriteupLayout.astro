---
import BaseLayout from './BaseLayout.astro';
import { withBase } from '../config';
import { formatDate } from '../utils/content';

interface Props {
  title: string; description: string; date: Date; tags?: string[];
  platform?: string; difficulty?: string; published?: boolean; minutes?: string;
}
const { title, description, date, tags = [], platform, difficulty, published = true, minutes } = Astro.props;
---
<BaseLayout title={title} description={description}>
  <article class="article shell-narrow">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href={withBase('/')}>home</a><span aria-hidden="true">/</span>
      <a href={withBase('/writeups/')}>writeups</a><span aria-hidden="true">/</span>
      <span aria-current="page">{title}</span>
    </nav>
    <header class="article-header">
      <div class="meta">
        <time datetime={date.toISOString()}>{formatDate(date)}</time>
        {platform && <span>{platform}</span>}
        {difficulty && <span>{difficulty}</span>}
        {minutes && <span>{minutes}</span>}
        {!published && <span style="color:var(--red-bright)">draft</span>}
      </div>
      <h1>{title}</h1>
      <p class="lede">{description}</p>
      {tags.length > 0 && (
        <div class="tag-list">
          {tags.map((tag) => <a class="tag" href={`${withBase('/writeups/')}?tag=${encodeURIComponent(tag)}`}>{tag}</a>)}
        </div>
      )}
    </header>
    <div class="prose"><slot /></div>
    <footer class="article-footer">
      <a class="back-link" href={withBase('/writeups/')}>← back to writeups</a>
      <span style="color:var(--faint);font-size:9px">thanks for reading ♡</span>
    </footer>
  </article>
  <script>
    document.querySelectorAll<HTMLElement>('.prose pre').forEach((pre) => {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'copy-code';
      button.textContent = 'copy';
      button.setAttribute('aria-label', 'Copy code block');
      button.addEventListener('click', async () => {
        await navigator.clipboard.writeText(pre.querySelector('code')?.textContent ?? '');
        button.textContent = 'copied ♡';
        setTimeout(() => (button.textContent = 'copy'), 1600);
      });
      pre.append(button);
    });
  </script>
</BaseLayout>
